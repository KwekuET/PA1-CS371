#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <errno.h>
#include <arpa/inet.h>
#include <sys/epoll.h>
#include <sys/socket.h>
#include <sys/time.h>
#include <sys/timerfd.h>
#include <fcntl.h>
#include <pthread.h>
#include <stdint.h>

#define MAX_EVENTS 64
#define MESSAGE_SIZE 16
#define DEFAULT_CLIENT_THREADS 4
#define DEFAULT_PIPELINE_SIZE 64
#define DEFAULT_TIMEOUT_MS 100
#define DEFAULT_SERVER_DELAY_US 0

#define PKT_TYPE_DATA 1
#define PKT_TYPE_ECHO 2

char *server_ip = "127.0.0.1";
int server_port = 12345;
int num_client_threads = DEFAULT_CLIENT_THREADS;
int num_requests = 1000000;
int pipeline_size = DEFAULT_PIPELINE_SIZE;
int timeout_ms = DEFAULT_TIMEOUT_MS;
int server_delay_us = DEFAULT_SERVER_DELAY_US;

typedef struct {
    uint32_t type;
    uint32_t seq;
    char payload[MESSAGE_SIZE];
} packet_t;

typedef struct {
    uint32_t seq;
    int active;
    struct timeval send_time;
} inflight_packet_t;

typedef struct {
    int epoll_fd;
    int socket_fd;
    int timer_fd;

    long long total_rtt;
    long total_messages;
    float request_rate;

    long tx_cnt;
    long rx_cnt;
    long lost_pkt_cnt;

    uint32_t next_seq;
    int inflight_count;
    inflight_packet_t *window;
} client_thread_data_t;

static long long time_diff_us(struct timeval start, struct timeval end) {
    return (end.tv_sec - start.tv_sec) * 1000000LL +
           (end.tv_usec - start.tv_usec);
}

static int set_nonblocking(int fd) {
    int flags = fcntl(fd, F_GETFL, 0);
    if (flags < 0) {
        return -1;
    }
    return fcntl(fd, F_SETFL, flags | O_NONBLOCK);
}

static void close_fd_if_valid(int *fd) {
    if (*fd >= 0) {
        close(*fd);
        *fd = -1;
    }
}

static int send_one_packet(client_thread_data_t *data, uint32_t seq) {
    packet_t pkt;
    inflight_packet_t *slot;

    slot = &data->window[seq % pipeline_size];

    /* Do not overwrite a slot that is still in flight */
    if (slot->active) {
        return 1;
    }

    memset(&pkt, 0, sizeof(pkt));
    pkt.type = PKT_TYPE_DATA;
    pkt.seq = seq;
    memcpy(pkt.payload, "ABCDEFGHIJKLMNO", 15);
    pkt.payload[15] = '\0';

    if (send(data->socket_fd, &pkt, sizeof(pkt), 0) != (ssize_t)sizeof(pkt)) {
        if (errno == EAGAIN || errno == EWOULDBLOCK) {
            return 1;
        }
        perror("send");
        return -1;
    }

    slot->seq = seq;
    slot->active = 1;
    gettimeofday(&slot->send_time, NULL);

    data->tx_cnt++;
    data->next_seq++;
    data->inflight_count++;

    return 0;
}

static void process_timeouts(client_thread_data_t *data) {
    struct timeval now;
    int i;

    gettimeofday(&now, NULL);

    for (i = 0; i < pipeline_size; i++) {
        long long age_us;

        if (!data->window[i].active) {
            continue;
        }

        age_us = time_diff_us(data->window[i].send_time, now);
        if (age_us >= (long long)timeout_ms * 1000LL) {
            data->window[i].active = 0;
            data->inflight_count--;
            data->lost_pkt_cnt++;
        }
    }
}

void *client_thread_func(void *arg) {
    client_thread_data_t *data = (client_thread_data_t *)arg;
    struct epoll_event event, events[MAX_EVENTS];

    data->request_rate = 0.0f;
    data->total_rtt = 0;
    data->total_messages = 0;
    data->tx_cnt = 0;
    data->rx_cnt = 0;
    data->lost_pkt_cnt = 0;
    data->next_seq = 0;
    data->inflight_count = 0;

    event.events = EPOLLIN;
    event.data.fd = data->socket_fd;
    if (epoll_ctl(data->epoll_fd, EPOLL_CTL_ADD, data->socket_fd, &event) < 0) {
        perror("epoll_ctl socket");
        return NULL;
    }

    event.events = EPOLLIN;
    event.data.fd = data->timer_fd;
    if (epoll_ctl(data->epoll_fd, EPOLL_CTL_ADD, data->timer_fd, &event) < 0) {
        perror("epoll_ctl timerfd");
        return NULL;
    }

    while (1) {
        while ((int)data->next_seq < num_requests &&
               data->inflight_count < pipeline_size) {
            int rc = send_one_packet(data, data->next_seq);
            if (rc < 0) {
                return NULL;
            }
            if (rc > 0) {
                break;
            }
        }

        if ((int)data->next_seq >= num_requests && data->inflight_count == 0) {
            break;
        }

        {
            int n_events = epoll_wait(data->epoll_fd, events, MAX_EVENTS, -1);
            if (n_events < 0) {
                if (errno == EINTR) {
                    continue;
                }
                perror("epoll_wait");
                break;
            }

            for (int i = 0; i < n_events; i++) {
                if (events[i].data.fd == data->socket_fd) {
                    while (1) {
                        packet_t pkt;
                        struct timeval end;
                        inflight_packet_t *slot;
                        ssize_t n = recv(data->socket_fd, &pkt, sizeof(pkt), 0);

                        if (n < 0) {
                            if (errno == EAGAIN || errno == EWOULDBLOCK) {
                                break;
                            }
                            perror("recv");
                            return NULL;
                        }

                        if ((size_t)n != sizeof(pkt)) {
                            continue;
                        }

                        if (pkt.type != PKT_TYPE_ECHO) {
                            continue;
                        }

                        slot = &data->window[pkt.seq % pipeline_size];
                        if (!slot->active || slot->seq != pkt.seq) {
                            continue;
                        }

                        gettimeofday(&end, NULL);
                        data->total_rtt += time_diff_us(slot->send_time, end);
                        data->total_messages++;
                        data->rx_cnt++;

                        slot->active = 0;
                        data->inflight_count--;
                    }
                } else if (events[i].data.fd == data->timer_fd) {
                    uint64_t expirations;

                    if (read(data->timer_fd, &expirations, sizeof(expirations)) < 0) {
                        if (errno != EAGAIN) {
                            perror("read timerfd");
                            return NULL;
                        }
                    }

                    process_timeouts(data);
                }
            }
        }
    }

    if (data->total_rtt > 0) {
        data->request_rate =
            (float)data->total_messages * 1000000.0f / (float)data->total_rtt;
    }

    close_fd_if_valid(&data->socket_fd);
    close_fd_if_valid(&data->timer_fd);
    close_fd_if_valid(&data->epoll_fd);

    return NULL;
}

void run_client() {
    pthread_t threads[num_client_threads];
    client_thread_data_t thread_data[num_client_threads];
    struct sockaddr_in server_addr;

    memset(&server_addr, 0, sizeof(server_addr));
    server_addr.sin_family = AF_INET;
    server_addr.sin_port = htons(server_port);

    if (inet_pton(AF_INET, server_ip, &server_addr.sin_addr) != 1) {
        fprintf(stderr, "Invalid server IP address\n");
        return;
    }

    for (int i = 0; i < num_client_threads; i++) {
        struct itimerspec its;

        memset(&thread_data[i], 0, sizeof(thread_data[i]));
        thread_data[i].epoll_fd = -1;
        thread_data[i].socket_fd = -1;
        thread_data[i].timer_fd = -1;

        thread_data[i].window =
            (inflight_packet_t *)calloc((size_t)pipeline_size, sizeof(inflight_packet_t));
        if (thread_data[i].window == NULL) {
            fprintf(stderr, "calloc failed for client window\n");
            return;
        }

        thread_data[i].epoll_fd = epoll_create1(0);
        if (thread_data[i].epoll_fd < 0) {
            perror("epoll_create1");
            free(thread_data[i].window);
            return;
        }

        thread_data[i].socket_fd = socket(AF_INET, SOCK_DGRAM, 0);
        if (thread_data[i].socket_fd < 0) {
            perror("socket");
            close_fd_if_valid(&thread_data[i].epoll_fd);
            free(thread_data[i].window);
            return;
        }

        if (set_nonblocking(thread_data[i].socket_fd) < 0) {
            perror("set_nonblocking socket");
            close_fd_if_valid(&thread_data[i].socket_fd);
            close_fd_if_valid(&thread_data[i].epoll_fd);
            free(thread_data[i].window);
            return;
        }

        if (connect(thread_data[i].socket_fd,
                    (struct sockaddr *)&server_addr,
                    sizeof(server_addr)) < 0) {
            perror("connect");
            close_fd_if_valid(&thread_data[i].socket_fd);
            close_fd_if_valid(&thread_data[i].epoll_fd);
            free(thread_data[i].window);
            return;
        }

        thread_data[i].timer_fd = timerfd_create(CLOCK_MONOTONIC, TFD_NONBLOCK);
        if (thread_data[i].timer_fd < 0) {
            perror("timerfd_create");
            close_fd_if_valid(&thread_data[i].socket_fd);
            close_fd_if_valid(&thread_data[i].epoll_fd);
            free(thread_data[i].window);
            return;
        }

        memset(&its, 0, sizeof(its));
        its.it_value.tv_sec = 0;
        its.it_value.tv_nsec = 1000000;
        its.it_interval.tv_sec = 0;
        its.it_interval.tv_nsec = 1000000;

        if (timerfd_settime(thread_data[i].timer_fd, 0, &its, NULL) < 0) {
            perror("timerfd_settime");
            close_fd_if_valid(&thread_data[i].timer_fd);
            close_fd_if_valid(&thread_data[i].socket_fd);
            close_fd_if_valid(&thread_data[i].epoll_fd);
            free(thread_data[i].window);
            return;
        }
    }

    for (int i = 0; i < num_client_threads; i++) {
        if (pthread_create(&threads[i], NULL, client_thread_func, &thread_data[i]) != 0) {
            perror("pthread_create");
            return;
        }
    }

    {
        long long total_rtt = 0;
        long total_messages = 0;
        float total_request_rate = 0.0f;
        long total_tx_cnt = 0;
        long total_rx_cnt = 0;
        long total_lost_pkt_cnt = 0;

        for (int i = 0; i < num_client_threads; i++) {
            pthread_join(threads[i], NULL);
            total_rtt += thread_data[i].total_rtt;
            total_messages += thread_data[i].total_messages;
            total_request_rate += thread_data[i].request_rate;
            total_tx_cnt += thread_data[i].tx_cnt;
            total_rx_cnt += thread_data[i].rx_cnt;
            total_lost_pkt_cnt += thread_data[i].lost_pkt_cnt;
            free(thread_data[i].window);
        }

        if (total_messages > 0) {
            printf("Average RTT: %lld us\n", total_rtt / total_messages);
        } else {
            printf("Average RTT: N/A\n");
        }

        printf("Total Request Rate: %.2f messages/s\n", total_request_rate);
        printf("tx_cnt: %ld\n", total_tx_cnt);
        printf("rx_cnt: %ld\n", total_rx_cnt);
        printf("lost_pkt_cnt: %ld\n", total_lost_pkt_cnt);
    }
}

void run_server() {
    int server_fd;
    int epoll_fd;
    struct sockaddr_in server_addr;
    struct epoll_event event, events[MAX_EVENTS];

    server_fd = socket(AF_INET, SOCK_DGRAM, 0);
    if (server_fd < 0) {
        perror("socket");
        return;
    }

    if (set_nonblocking(server_fd) < 0) {
        perror("set_nonblocking");
        close(server_fd);
        return;
    }

    memset(&server_addr, 0, sizeof(server_addr));
    server_addr.sin_family = AF_INET;
    server_addr.sin_addr.s_addr = INADDR_ANY;
    server_addr.sin_port = htons(server_port);

    if (bind(server_fd, (struct sockaddr *)&server_addr, sizeof(server_addr)) < 0) {
        perror("bind");
        close(server_fd);
        return;
    }

    epoll_fd = epoll_create1(0);
    if (epoll_fd < 0) {
        perror("epoll_create1");
        close(server_fd);
        return;
    }

    event.events = EPOLLIN;
    event.data.fd = server_fd;
    if (epoll_ctl(epoll_fd, EPOLL_CTL_ADD, server_fd, &event) < 0) {
        perror("epoll_ctl");
        close(server_fd);
        close(epoll_fd);
        return;
    }

    while (1) {
        int n_events = epoll_wait(epoll_fd, events, MAX_EVENTS, -1);
        if (n_events < 0) {
            if (errno == EINTR) {
                continue;
            }
            perror("epoll_wait");
            break;
        }

        for (int i = 0; i < n_events; i++) {
            if (events[i].data.fd == server_fd) {
                while (1) {
                    packet_t pkt;
                    struct sockaddr_in client_addr;
                    socklen_t client_len = sizeof(client_addr);

                    ssize_t n = recvfrom(server_fd, &pkt, sizeof(pkt), 0,
                                         (struct sockaddr *)&client_addr, &client_len);

                    if (n < 0) {
                        if (errno == EAGAIN || errno == EWOULDBLOCK) {
                            break;
                        }
                        perror("recvfrom");
                        break;
                    }

                    if ((size_t)n != sizeof(pkt)) {
                        continue;
                    }

                    if (server_delay_us > 0) {
                        usleep((useconds_t)server_delay_us);
                    }

                    pkt.type = PKT_TYPE_ECHO;
                    if (sendto(server_fd, &pkt, sizeof(pkt), 0,
                               (struct sockaddr *)&client_addr, client_len) < 0) {
                        perror("sendto");
                    }
                }
            }
        }
    }

    close(server_fd);
    close(epoll_fd);
}

int main(int argc, char *argv[]) {
    if (argc > 1 && strcmp(argv[1], "server") == 0) {
        if (argc > 2) {
            server_ip = argv[2];
        }
        if (argc > 3) {
            server_port = atoi(argv[3]);
        }
        if (argc > 4) {
            server_delay_us = atoi(argv[4]);
        }
        run_server();
    } else if (argc > 1 && strcmp(argv[1], "client") == 0) {
        if (argc > 2) {
            server_ip = argv[2];
        }
        if (argc > 3) {
            server_port = atoi(argv[3]);
        }
        if (argc > 4) {
            num_client_threads = atoi(argv[4]);
        }
        if (argc > 5) {
            num_requests = atoi(argv[5]);
        }
        if (argc > 6) {
            pipeline_size = atoi(argv[6]);
        }
        if (argc > 7) {
            timeout_ms = atoi(argv[7]);
        }
        run_client();
    } else {
        printf("Usage:\n");
        printf("  %s server [server_ip server_port server_delay_us]\n", argv[0]);
        printf("  %s client [server_ip server_port num_client_threads num_requests pipeline_size timeout_ms]\n", argv[0]);
    }

    return 0;
}
